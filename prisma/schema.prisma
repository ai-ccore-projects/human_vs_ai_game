// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  id        Int      @id @default(autoincrement())
  gameId    String   @unique
  name      String
  score     Int
  round     Int
  maxCombo  Int
  createdAt DateTime @default(now())
}



model Image {
  id     Int     @id @default(autoincrement())
  url    String  @unique
  isAi   Boolean @default(false) @map("is_ai")
  active Boolean @default(true)

  seenInSessions ImageSessionSeen[]

  @@map("images")
}

model ImageSession {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  seenImages ImageSessionSeen[]

  @@map("image_sessions")
}

model ImageSessionSeen {
  id        Int      @id @default(autoincrement())
  sessionId Int      @map("session_id")
  imageId   Int      @map("image_id")
  seenAt    DateTime @default(now()) @map("seen_at")

  session ImageSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  image   Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([sessionId, imageId])
  @@index([sessionId])
  @@map("image_session_seen")
}
